{
  "name": "second-draft",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that rewrites what you typed using Chrome's built-in on-device model. No network access.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "gen:i18n": "node scripts/gen-i18n-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/check-node.mjs && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && node scripts/gen-i18n-types.mjs --check && node scripts/check-manifest.mjs && node scripts/check-i18n.mjs && npm test",
    "package": "npm run build && npm run check && node scripts/check-size.mjs && node scripts/package.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.6",
    "@types/dom-chromium-ai": "0.0.17",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "happy-dom": "20.11.2",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
